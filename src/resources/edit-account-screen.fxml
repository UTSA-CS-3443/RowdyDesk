<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="programLogic.controllerCode.EditAccountController">
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="407.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/rowdydesk.png" />
                     </image>
                  </ImageView>
                  <Label text="Edit Account Info" />
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <VBox prefHeight="109.0" prefWidth="286.0">
                     <children>
                        <TextField fx:id="usernameField" promptText="Username" />
                        <TextField fx:id="displayNameField" promptText="Display Name (Full Name)" />
                        <TextField fx:id="emailField" promptText="Email" />
                        <TextField fx:id="phoneField" promptText="Phone" />
                        <PasswordField fx:id="passwordField" onKeyPressed="#enterKeyPressed" promptText="Enter Password to Confirm Edits" />
                        <Label fx:id="errorLabel" textFill="RED" />
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="5.0">
               <children>
                  <Button mnemonicParsing="false" onMouseClicked="#onDoneButtonClicked" text="Apply" />
                  <Button layoutX="235.0" layoutY="28.0" mnemonicParsing="false" onMouseClicked="#onCancelButtonClicked" text="Cancel" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <Label text="RING! - CS3443 - Fall 2026" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
