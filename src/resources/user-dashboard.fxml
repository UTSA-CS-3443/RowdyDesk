<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="programLogic.controllerCode.UserDashboardController">
   <bottom>
      <Label text="RowdyDesk Software WIP" BorderPane.alignment="CENTER" />
   </bottom>
   <top>
      <VBox prefHeight="80.0" prefWidth="600.0" BorderPane.alignment="CENTER">
