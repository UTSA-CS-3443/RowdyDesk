            <ToolBar prefHeight="40.0" prefWidth="200.0">
               <items>
                  <Label text="RowdyDesk" />
                  <HBox alignment="CENTER" prefHeight="29.0" prefWidth="492.0">
                     <children>
                        <Button fx:id="newTicketButton" mnemonicParsing="false" onMouseClicked="#onNewTicketButtonClicked" prefHeight="26.0" prefWidth="95.0" text="New Ticket" textFill="RED" />
                        <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="65.0" text="Logout" />
                     </children>
                  </HBox>
               </items>
            </ToolBar>
         </children>
      </VBox>
   </top>
   <center>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
