                        <Insets />
                     </BorderPane.margin></ImageView>
               </top>
               <padding>
                  <Insets top="10.0" />
               </padding>
               <bottom>
                  <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
                     <children>
                        <Label fx:id="nameLabel" text="Friendly Dog">
                           <padding>
                              <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                           </padding>
                        </Label>
                        <Label fx:id="phoneLabel" text="210-458-5555">
                           <padding>
                              <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                           </padding>
