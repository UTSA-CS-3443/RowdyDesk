<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="8.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="programLogic.controllerCode.AdminTicketListController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <Label fx:id="headingLabel" text="All Tickets">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="searchField" promptText="Search by number, description, status, or name" HBox.hgrow="ALWAYS" />
            <Label fx:id="countLabel" text="0 tickets" />
            <Button mnemonicParsing="false" onAction="#openSelected" text="Open Selected" />
         </children>
      </HBox>
      <TableView fx:id="ticketsTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="numberCol" prefWidth="70.0" text="Ticket #" />
            <TableColumn fx:id="shortCol" prefWidth="170.0" text="Short Description" />
            <TableColumn fx:id="statusCol" prefWidth="80.0" text="Status" />
            <TableColumn fx:id="openedForCol" prefWidth="95.0" text="Opened For" />
            <TableColumn fx:id="assignedCol" prefWidth="95.0" text="Assigned To" />
            <TableColumn fx:id="createdCol" prefWidth="80.0" text="Created" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
