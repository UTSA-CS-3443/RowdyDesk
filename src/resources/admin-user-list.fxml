<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="8.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="programLogic.controllerCode.AdminUserListController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <Label text="User List">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="searchField" promptText="Search by username, name, or email" HBox.hgrow="ALWAYS" />
            <Label fx:id="countLabel" text="0 users" />
            <Button mnemonicParsing="false" onAction="#modifySelected" text="Modify User" />
         </children>
      </HBox>
      <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="usernameCol" prefWidth="110.0" text="Username" />
            <TableColumn fx:id="displayNameCol" prefWidth="130.0" text="Display Name" />
            <TableColumn fx:id="emailCol" prefWidth="170.0" text="Email" />
            <TableColumn fx:id="phoneCol" prefWidth="100.0" text="Phone" />
            <TableColumn fx:id="roleCol" prefWidth="60.0" text="Role" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
